{
  "name": "luma-image-agent",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Luma · 对话式 AI 与图片创作智能体",
  "author": "Luma",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "desktop": "electron .",
    "desktop:pack": "node desktop/build.cjs --dir --publish never",
    "desktop:build:mac": "node desktop/build.cjs --mac --x64 --arm64 --publish never",
    "desktop:build:mac:x64": "node desktop/build.cjs --mac --x64 --publish never",
    "desktop:build:mac:arm64": "node desktop/build.cjs --mac --arm64 --publish never",
    "desktop:build:win": "node desktop/build.cjs --win --x64 --publish never",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "jsqr": "^1.4.0"
  },
  "build": {
    "appId": "com.luma.imagegen",
    "productName": "Luma",
    "artifactName": "Luma-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "src/**/*",
      "public/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "guoxiang2023",
        "repo": "AI-Image-Studio"
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": "dmg",
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma"
    },
    "dmg": {
      "title": "Luma ${version}"
    },
    "afterPack": "desktop/after-pack.cjs",
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  }
}
